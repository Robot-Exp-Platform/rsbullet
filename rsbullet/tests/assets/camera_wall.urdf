<?xml version="1.0"?>
<!-- A 6 m x 6 m wall, 0.02 m thick, centred on its base frame; seen by the camera projection and depth tests. -->
<robot name="camera_wall">
  <link name="wall">
    <visual><geometry><box size="6.0 6.0 0.02"/></geometry></visual>
    <collision><geometry><box size="6.0 6.0 0.02"/></geometry></collision>
  </link>
</robot>
