<?xml version="1.0"?>
<!-- A base whose centre of mass is neither at nor aligned with its URDF
     frame: the inertial origin is offset and turned, and the inertia is not
     diagonal, so Bullet also turns the inertial frame to the principal axes
     when it uses the file's inertia. A child link hangs on a revolute joint
     0.3 m ahead of the base frame. -->
<robot name="offset_inertia_base">
  <link name="base">
    <inertial>
      <origin xyz="0.12 -0.05 0.03" rpy="0 0 0.3"/>
      <mass value="2"/>
      <inertia ixx="0.02" ixy="0.004" ixz="0" iyy="0.03" iyz="0" izz="0.04"/>
    </inertial>
    <collision>
      <geometry><box size="0.4 0.2 0.1"/></geometry>
    </collision>
  </link>
  <link name="arm">
    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="hinge" type="revolute">
    <parent link="base"/><child link="arm"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="2" velocity="1"/>
  </joint>
</robot>
